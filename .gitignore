# ==========================================
# Voucher-Forge - Git Ignore Configuration
# ==========================================

# --- Python build & compilation artifacts ---
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/

# --- Virtual Environments ---
.venv/
venv/
env/
ENV/

# --- Testing & Quality Assurance ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# --- IDEs & System ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
tempCodeRunnerFile.py

# --- Runtime Data & Storage Engine Isolation ---
# Block all dynamic user data, saves, generated PDFs and uploaded graphics
data/exports/*
data/bundles/*
data/assets/*
data/**/.tmp_*

# Ignore user custom templates while keeping directories in git
data/templates/*.json

# Keep empty directory structures tracked in Git
!data/assets/.gitkeep
!data/exports/.gitkeep
!data/bundles/.gitkeep
!data/templates/.gitkeep