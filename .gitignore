# ==========================================
# Voucher-Forge - Git Ignore Configuration
# ==========================================

# --- Python build & compilation artifacts ---
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/

# --- Virtual Environments ---
.venv/
venv/
env/
ENV/

# --- Testing & Quality Assurance ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# --- IDEs & System ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
tempCodeRunnerFile.py

# --- Runtime Data & Storage Engine Integrity ---
# Ignore all generated JSON databases, PDFs, presets and temporary atomic buffers
data/templates/*.json
data/bundles/*.json
data/presets/*.json
data/exports/*
data/**/.tmp_*
data/assets/*

# Keep asset directory structure tracked in git
!data/assets/.gitkeep